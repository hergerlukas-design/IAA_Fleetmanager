# IAA Nutzfahrzeuge – Fleet Manager
# ---------------------------------------------------------------------------
# Vorlage für lokale Entwicklung. Kopieren nach `.env` und Werte eintragen:
#
#     cp .env.example .env
#
# `.env` und `.env.local` sind in .gitignore und werden NICHT eingecheckt.
# Für Deploys (Fly.io via GitHub Actions) müssen dieselben Werte als
# GitHub-Repo-Secrets hinterlegt sein – siehe .github/workflows/deploy.yml.
# Alle VITE_*-Variablen werden zur BUILD-ZEIT eingebettet und sind im
# ausgelieferten Client sichtbar. Keine echten Server-/Service-Keys hier!
# ---------------------------------------------------------------------------

# Supabase-Projekt-URL (Project Settings → Data API → Project URL)
# z. B. https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase Anon / Publishable Key (Project Settings → API Keys → anon/public)
# Öffentlicher Client-Key – RLS schützt die Daten, nicht dieser Key.
VITE_SUPABASE_KEY=

# App-Secret für den x-app-secret-Header (RLS-Gatekeeper).
# NICHT extern abrufbar – selbst generieren, z. B.:  openssl rand -base64 32
# Derselbe Wert muss in Supabase in der Tabelle _app_secret stehen:
#     INSERT INTO _app_secret (secret) VALUES ('<derselbe-wert>');
# Muss byte-genau mit dem DB-Wert übereinstimmen, sonst blockiert RLS alles.
VITE_APP_SECRET=

# App-Passwort für den Login (frei wählbar).
VITE_APP_PASSWORD=

# Admin-PIN für Admin-Funktionen (z. B. Duplikat-/Orphan-Scan) – frei wählbar.
VITE_ADMIN_PIN=
